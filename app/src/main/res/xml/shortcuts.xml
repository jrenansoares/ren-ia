<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="camera"
        android:enabled="true"
        android:icon="@drawable/ic_lucide_camera"
        android:shortcutShortLabel="@string/shortcut_take_picture"
        android:shortcutLongLabel="@string/shortcut_take_picture">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="br.com.projetoia.app.ui.activity.ShortcutHandlerActivity"
            android:data="projetoia://shortcut" />
        <categories android:name="android.shortcut.conversation" />
    </shortcut>
    <shortcut
        android:shortcutId="translator"
        android:enabled="true"
        android:icon="@drawable/ic_translate"
        android:shortcutShortLabel="@string/translator_page_title"
        android:shortcutLongLabel="@string/translator_page_title">
        <intent
            android:action="br.com.projetoia.app.action.TRANSLATE"
            android:targetClass="br.com.projetoia.app.RouteActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="media_creation"
        android:enabled="true"
        android:icon="@drawable/ic_media_creation"
        android:shortcutShortLabel="@string/shortcut_media_creation"
        android:shortcutLongLabel="@string/shortcut_media_creation">
        <intent
            android:action="br.com.projetoia.app.action.MEDIA_CREATION"
            android:targetClass="br.com.projetoia.app.RouteActivity" />
    </shortcut>
</shortcuts>
